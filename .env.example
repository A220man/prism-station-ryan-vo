# Application
APP_NAME=prism-station
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./prism_station.db

# Security (REQUIRED: change in production, min 32 chars)
SECRET_KEY=dev-secret-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC/Keycloak (optional)
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/prism-station
OIDC_CLIENT_ID=prism-station
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# LLM Provider (optional, for advisory skill analysis)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000